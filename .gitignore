# Claude Code agent worktrees (exact copies of source — exclude from tooling scans)
.claude/worktrees/

# Generated governance artifacts (gitignore only; committed roll-up lives in agent/baselines/)
FUCKIT.md
agent/repo-score.json
agent/repo-score.md

# SBOM artifacts (committed roll-up only)
sbom/*
!sbom/.keep
!sbom/index.md

# Generated zone directory stubs (tracked .keep files only; content is gitignored)
!.venv/.keep
!artifacts/.keep
!build/.keep
!dist/.keep

# Benchmark zone fixture files (tracked as zone-existence evidence, not real ML artifacts)
!benchmarks/fixtures/
!benchmarks/fixtures/*.zarr
!benchmarks/fixtures/*.parquet
!benchmarks/fixtures/*.npy
!benchmarks/fixtures/*.npz
!benchmarks/fixtures/*.pt
!benchmarks/fixtures/*.pth
!benchmarks/fixtures/*.onnx
!benchmarks/fixtures/*.ckpt
!benchmarks/fixtures/*.sqlite
!benchmarks/fixtures/*.db
# Local jankurai state (receipts/hooks state — not committed)
.jankurai/
