{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/object_pack_manifest.schema.json",
  "title": "EchoForge Object Pack Manifest",
  "type": "object",
  "required": ["schema_ref", "id", "display_name", "purpose", "public_proxy", "object_card_refs", "material_card_refs", "validation_tier", "notes"],
  "properties": {
    "schema_ref": { "type": "string" },
    "id": { "type": "string" },
    "display_name": { "type": "string" },
    "purpose": { "type": "string" },
    "public_proxy": { "type": "boolean" },
    "object_card_refs": { "type": "array", "items": { "type": "string" } },
    "material_card_refs": { "type": "array", "items": { "type": "string" } },
    "validation_tier": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}

