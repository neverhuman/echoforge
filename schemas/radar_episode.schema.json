{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoforge.local/schemas/radar_episode.schema.json",
  "title": "radar_episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "schema_version",
    "public_proxy_id",
    "provenance",
    "license",
    "validation",
    "episode_name",
    "scenario_id",
    "sample_rate_hz",
    "product_paths"
  ],
  "properties": {
    "id": { "$ref": "./common.schema.json#/$defs/deterministic_id" },
    "kind": { "const": "radar_episode" },
    "schema_version": { "$ref": "./common.schema.json#/$defs/schema_version" },
    "public_proxy_id": { "$ref": "./common.schema.json#/$defs/slug" },
    "provenance": { "$ref": "./common.schema.json#/$defs/provenance" },
    "license": { "$ref": "./common.schema.json#/$defs/license" },
    "validation": { "$ref": "./common.schema.json#/$defs/validation" },
    "episode_name": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "sample_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
    "product_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
