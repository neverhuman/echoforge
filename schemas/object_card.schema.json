{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoforge.local/schemas/object_card.schema.json",
  "title": "object_card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "schema_version",
    "public_proxy_id",
    "provenance",
    "license",
    "validation",
    "display_name",
    "object_family",
    "geometry_variant",
    "material_variant",
    "dimensions_m"
  ],
  "properties": {
    "id": { "$ref": "./common.schema.json#/$defs/deterministic_id" },
    "kind": { "const": "object_card" },
    "schema_version": { "$ref": "./common.schema.json#/$defs/schema_version" },
    "public_proxy_id": { "$ref": "./common.schema.json#/$defs/slug" },
    "provenance": { "$ref": "./common.schema.json#/$defs/provenance" },
    "license": { "$ref": "./common.schema.json#/$defs/license" },
    "validation": { "$ref": "./common.schema.json#/$defs/validation" },
    "display_name": { "type": "string", "minLength": 1 },
    "object_family": { "type": "string", "minLength": 1 },
    "geometry_variant": { "type": "string", "minLength": 1 },
    "material_variant": { "type": "string", "minLength": 1 },
    "dimensions_m": { "$ref": "./common.schema.json#/$defs/vector3" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
