{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoforge.local/schemas/passive_rf_sensor_card.schema.json",
  "title": "passive_rf_sensor_card",
  "description": "EchoForge passive_rf_sensor_card document. Declares a passive RF / electronic-support sensor (single baseline, TDOA network, interferometric, monopulse panels) that detects emitter signals like drone control links, video downlinks, telemetry, or GNSS receivers. Important context per tips/detectors/tip1.txt §4.6: passive RF is excellent against many commercial quadcopters but WEAKER against pre-programmed one-way attack drones like Shahed that do NOT emit a controller link. Strict-open: vendor names allowed; ITU-R / SDR-handbook references for sensitivity and TDOA accuracy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "schema_version",
    "public_proxy_id",
    "provenance",
    "license",
    "validation",
    "sensor_name",
    "frequency_range_hz",
    "sensitivity_dbm",
    "aoa_method"
  ],
  "properties": {
    "id": { "$ref": "https://echoforge.local/schemas/common.schema.json#/$defs/deterministic_id" },
    "kind": { "const": "passive_rf_sensor_card" },
    "schema_version": { "$ref": "https://echoforge.local/schemas/common.schema.json#/$defs/schema_version" },
    "public_proxy_id": { "$ref": "https://echoforge.local/schemas/common.schema.json#/$defs/slug" },
    "provenance": { "$ref": "https://echoforge.local/schemas/common.schema.json#/$defs/provenance" },
    "license": { "$ref": "https://echoforge.local/schemas/common.schema.json#/$defs/license" },
    "validation": { "$ref": "https://echoforge.local/schemas/common.schema.json#/$defs/validation" },
    "sensor_name": { "type": "string", "minLength": 1 },
    "vendor": { "type": "string" },
    "model": { "type": "string" },
    "frequency_range_hz": { "$ref": "https://echoforge.local/schemas/common.schema.json#/$defs/numeric_range" },
    "instantaneous_bandwidth_hz": { "type": "number", "exclusiveMinimum": 0 },
    "sensitivity_dbm": {
      "type": "number",
      "description": "Receiver minimum-detectable-signal in dBm at the declared bandwidth (typical SDR -100 to -130 dBm depending on NF and integration)."
    },
    "noise_figure_db": { "type": "number", "minimum": 0 },
    "aoa_method": {
      "enum": [
        "single_baseline_interferometry",
        "tdoa_network_three_or_more",
        "phase_interferometry_multi_baseline",
        "monopulse_amplitude_comparison",
        "monopulse_phase_comparison",
        "watson_watt",
        "doa_correlation_array",
        "none_emitter_id_only"
      ]
    },
    "bearing_accuracy_deg": { "type": "number", "exclusiveMinimum": 0 },
    "tdoa_network_baseline_km": {
      "$ref": "https://echoforge.local/schemas/common.schema.json#/$defs/numeric_range",
      "description": "For TDOA networks, the typical inter-site baseline range (km)."
    },
    "tdoa_timing_accuracy_ns": { "type": "number", "exclusiveMinimum": 0 },
    "antenna": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "antenna_type": { "enum": ["omnidirectional", "dipole_array", "log_periodic", "horn", "patch_array", "biconical"] },
        "gain_dbi": { "type": "number" },
        "polarization": { "enum": ["vv", "hh", "lhcp", "rhcp", "dual_linear", "dual_circular"] }
      }
    },
    "target_emission_classes": {
      "description": "Emission types this sensor is configured to detect.",
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "gnss_l1_active_receiver",
          "control_link_2_4ghz_ism",
          "control_link_5_8ghz_ism",
          "control_link_900mhz_ism",
          "video_downlink_5_8ghz",
          "telemetry_868mhz_915mhz",
          "datalink_uhf",
          "datalink_vhf",
          "datalink_satcom",
          "primary_radar_emission",
          "secondary_surveillance_radar_atc",
          "cellular_lte_uplink",
          "wifi_2_4ghz",
          "wifi_5ghz",
          "bluetooth"
        ]
      }
    },
    "network_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of sensor sites in a deployed network (TDOA requires ≥3 for 2D location, ≥4 for 3D)."
    },
    "declared_detection_envelope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_class_slug", "range_m", "conditions"],
        "properties": {
          "target_class_slug": { "$ref": "https://echoforge.local/schemas/common.schema.json#/$defs/slug" },
          "range_m": { "type": "number", "exclusiveMinimum": 0 },
          "conditions": { "type": "string" },
          "citation_id": { "type": "string" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known limitations (e.g. 'cannot detect pre-programmed RF-silent OWA drones', 'cluttered urban RF environment degrades AoA accuracy')."
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citation_id"],
        "properties": {
          "citation_id": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "retrieved_utc": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
