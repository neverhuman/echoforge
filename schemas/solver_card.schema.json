{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoforge.local/schemas/solver_card.schema.json",
  "title": "solver_card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "schema_version",
    "public_proxy_id",
    "provenance",
    "license",
    "validation",
    "solver_name",
    "solver_family",
    "version",
    "container_image"
  ],
  "properties": {
    "id": { "$ref": "./common.schema.json#/$defs/deterministic_id" },
    "kind": { "const": "solver_card" },
    "schema_version": { "$ref": "./common.schema.json#/$defs/schema_version" },
    "public_proxy_id": { "$ref": "./common.schema.json#/$defs/slug" },
    "provenance": { "$ref": "./common.schema.json#/$defs/provenance" },
    "license": { "$ref": "./common.schema.json#/$defs/license" },
    "validation": { "$ref": "./common.schema.json#/$defs/validation" },
    "solver_name": { "type": "string", "minLength": 1 },
    "solver_family": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "container_image": { "type": "string", "minLength": 1 },
    "supported_polarizations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
