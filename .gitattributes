# Text files: normalize line endings to LF in repository
* text=auto eol=lf

# Rust source: always LF
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files: do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.svg text eol=lf

# Lock files: preserve as-is
Cargo.lock text eol=lf -merge
package-lock.json text eol=lf

# Justfile
Justfile text eol=lf

# Dockerfiles
*.Dockerfile text eol=lf

# git-crypt protected Engineered Intelligence runtime implementation.
detection/crypt_ip_impl/advanced_main_run_detectors.py filter=git-crypt diff=git-crypt -text
detection/crypt_ip_impl/ei_evolution_trace.py filter=git-crypt diff=git-crypt -text
