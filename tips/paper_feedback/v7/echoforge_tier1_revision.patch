+        "f1_relative_pct": ((selected_f1 / baseline_f1) - 1.0) * 100.0 if baseline_f1 > 0 else float("nan"),
+        "selected_fp": selected_fp,
+        "baseline_fp": baseline_fp,
+        "fp_reduction_pct": (1.0 - selected_fp / baseline_fp) * 100.0 if baseline_fp > 0 else float("nan"),
+    }
