+def _main_kpi_gain_rows(eval_summary: dict[str, Any]) -> list[dict[str, Any]]:
+    baseline = eval_summary.get("baseline", {})
+    selected = eval_summary.get("selected", {})
+    metrics = [
+        ("LCB95 Recall@<=1%FPR", baseline.get("primary_kpi", {}).get("value"), selected.get("primary_kpi", {}).get("value"), "higher_is_better"),
+        ("Point Recall@<=1%FPR", baseline.get("fixed_fpr_recall"), selected.get("fixed_fpr_recall"), "higher_is_better"),
+        ("Average precision", baseline.get("average_precision"), selected.get("average_precision"), "higher_is_better"),
+        ("Selected-threshold false positives", baseline.get("fp"), selected.get("fp"), "lower_is_better"),
+        ("F1", baseline.get("f1"), selected.get("f1"), "higher_is_better"),
+        ("ROC AUC", baseline.get("roc_auc"), selected.get("roc_auc"), "guardrail_tradeoff"),
+    ]
+    rows = []
+    for metric, prior_raw, ei_raw, direction in metrics:
+        prior = _safe_float(prior_raw)
+        ei = _safe_float(ei_raw)
+        absolute = ei - prior if math.isfinite(prior) and math.isfinite(ei) else float("nan")
+        if metric == "Selected-threshold false positives" and prior > 0:
+            relative = (prior - ei) / prior
+            summary = f"{relative * 100.0:.1f}% fewer"
+        elif prior != 0 and math.isfinite(prior) and math.isfinite(ei):
+            relative = absolute / abs(prior)
+            summary = f"{relative * 100.0:+.1f}%"
+        else:
+            relative = float("nan")
+            summary = "n/a"
+        rows.append({"metric": metric, "prior_fusion": prior, "ei_candidate": ei, "absolute_change": absolute, "relative_change": relative, "direction": direction, "reader_summary": summary})
+    return rows
+
+def _processing_pipeline_rows() -> list[dict[str, Any]]:
+    return [
+        {"stage": "scenario_sampling", "artifact": "scenario_manifest.csv", "model_visible": "stratified detector summaries only", "blocked": "label, split role, group ID, hidden generator state"},
+        {"stage": "phase_expansion", "artifact": "records.csv", "model_visible": "phase-specific detector rows", "blocked": "time-lock ID and raw provenance handles"},
+        {"stage": "radar_cue_synthesis", "artifact": "raw_complex_iq refs + cue streams", "model_visible": "range-Doppler/track/cue summaries", "blocked": "raw arrays and measured raw files"},
+        {"stage": "detector_view_materialization", "artifact": "detector_views/*.csv", "model_visible": "numeric detector-view features after denylist", "blocked": "MODEL_FEATURE_DENYLIST and DETECTOR_ID_COLUMNS"},
+        {"stage": "baseline_and_ei_scoring", "artifact": "performance_metrics.csv + selection_lock.json", "model_visible": "calibrated scores and holdout metrics", "blocked": "holdout tuning and post-lock candidate changes"},
+    ]
