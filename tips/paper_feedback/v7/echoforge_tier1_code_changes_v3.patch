 }
@@
+def figure_data_processing_flow(context: FigureContext) -> Path:
+    filename = "data_processing_flow.png"
+    _note_source(filename, "paper evidence data-processing contract")
+    fig, ax = plt.subplots(figsize=(IEEE_TEXT_WIDTH_IN, 2.85), constrained_layout=False)
+    fig.subplots_adjust(left=0.03, right=0.98, top=0.86, bottom=0.10)
+    ax.set_xlim(0, 10)
+    ax.set_ylim(0, 5)
+    ax.axis("off")
+    ax.text(0.0, 4.72, "Data processing contract: simulation to evidence", fontsize=FONT_TITLE, weight="bold")
+    ax.text(0.0, 4.38, "Raw generator state is separated from detector-facing features and audit evidence.", fontsize=FONT_TINY, color=MUTED)
+    stages = [
+        ("Scenario\ngroups", PALE_BLUE, BLUE),
+        ("Phase\nrecords", PALE_TEAL, TEAL),
+        ("Synthetic IQ\n+ cues", PALE_GOLD, GOLD),
+        ("Detector-view\nfeatures", PALE_GREEN, GREEN),
+        ("Train/CV lock", "white", GRID),
+        ("Blind holdout\nevidence", SLATE, INK),
+    ]
+    x0, y0, w, gap = 0.15, 2.65, 1.32, 0.28
+    for idx, (label, face, edge) in enumerate(stages):
+        x = x0 + idx * (w + gap)
+        _add_box(ax, x, y0, w, 0.86, label, face=face, edge=edge, weight="bold", size=FONT_TINY, wrap_width=15)
+        if idx < len(stages) - 1:
+            _add_arrow(ax, (x + w + 0.02, y0 + 0.43), (x + w + gap - 0.02, y0 + 0.43), color=MUTED)
+    rails = [
+        ("Split is group-locked before phase expansion", 0.25, 1.55),
+        ("Range-Doppler panels are qualitative, not main KPI inputs", 3.35, 1.55),
+        ("Labels, split keys, group IDs, time locks, and audit headers are denied", 0.25, 0.70),
+        ("Evidence artifacts include KPI, curves, calibration, leakage, and false-alarm CSV/JSON", 3.35, 0.70),
+    ]
+    for text, x, y in rails:
+        _add_box(ax, x, y, 2.95, 0.55, text, face="white", edge=GRID, size=FONT_TINY, wrap_width=34)
+    ax.text(0.25, 0.18, "Evidence row: data_processing_contract.csv", fontsize=FONT_TINY, color=MUTED)
+    return _save_figure(fig, filename)
@@
 def generate_all(context: FigureContext) -> list[Path]:
@@
         figure_appendix_modeling_map(context),
+        figure_data_processing_flow(context),
     ]

