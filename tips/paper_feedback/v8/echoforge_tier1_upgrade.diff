+        },
+    ]
+
+
+def _sensor_fusion_pipeline_rows() -> list[dict[str, Any]]:
+    return [
+        {"stage": "branch_scores", "input": "X/Ku|S-band|GBAD|acoustic|passive-RF detector views", "output": "per-branch scores and failure slices", "guardrail": "branch cards state excluded truth fields"},
+        {"stage": "human_fusion", "input": "branch scores|source confidence|stale-track flags|cross-sensor confirmation", "output": "accepted prior fusion score and train/CV threshold", "guardrail": "main comparator is not a straw baseline"},
