@@ -0,0 +1,166 @@
+#!/usr/bin/env python3
+"""Render the one-column source-code appendix with line-origin coloring.
+
+The static TeX appendix can fall back to plain listings. This script creates a
+generated TeX file that colors lines marked `ORIGIN:GENERATIVE` with a light
+blue background and replaces the sealed EI core with a digest/ciphertext note.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+
+def _escape_tex(text: str) -> str:
+    replacements = {
+        "\\": r"\textbackslash{}",
+        "{": r"\{",
+        "}": r"\}",
+        "_": r"\_",
+        "&": r"\&",
+        "%": r"\%",
+        "#": r"\#",
+        "$": r"\$",
+        "^": r"\textasciicircum{}",
+        "~": r"\textasciitilde{}",
+    }
+    return "".join(replacements.get(ch, ch) for ch in text.rstrip("\n"))
+
+
+def _line_box(line: str, *, generated: bool = False, sealed: bool = False) -> str:
+    escaped = _escape_tex(line)
+    color = "EchoGeneratedBg" if generated else "EchoSealBg" if sealed else "white"
+    if generated or sealed:
+        return rf"\colorbox{{{color}}}{{\makebox[0.98\linewidth][l]{{\strut\ttfamily\scriptsize {escaped}}}}}"
+    return rf"{{\ttfamily\scriptsize {escaped}}}"
+
+
+def _render_listing(entry: dict[str, object]) -> str:
+    rel_path = str(entry["path"])
+    path = REPO_ROOT / rel_path
+    caption = _escape_tex(str(entry.get("caption", rel_path)))
+    listing_id = _escape_tex(str(entry.get("id", path.stem)))
+    marker = str(entry.get("generative_marker", "ORIGIN:GENERATIVE"))
+    sealed_markers = entry.get("sealed_markers", [])
+    start_marker = str(sealed_markers[0]) if isinstance(sealed_markers, list) and sealed_markers else "IP_CORE_START"
+    end_marker = str(sealed_markers[1]) if isinstance(sealed_markers, list) and len(sealed_markers) > 1 else "IP_CORE_END"
+    if not path.exists():
+        return f"\\subsection*{{Missing listing: {listing_id}}}\n\\emph{{Expected {rel_path}.}}\n"
+
+    rows = [
+        rf"\subsection*{{{caption}}}",
+        rf"\label{{lst:generated-{listing_id}}}",
+        r"\begin{tcolorbox}[breakable,colback=white,colframe=EchoFrame,boxrule=0.35pt,left=2pt,right=2pt,top=2pt,bottom=2pt]",
+        r"\begin{Verbatim}[commandchars=\\\{\},fontsize=\scriptsize]",
+    ]
+    sealed = False
+    emitted_seal_note = False
+    for line_no, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
+        if start_marker in line:
+            sealed = True
+            rows.append(_line_box(f"# sealed EI high-IP core begins at source line {line_no}", sealed=True))
+            if not emitted_seal_note:
+                rows.append(_line_box("# exact lines are in paper/generated/ei_ip_core.enc.txt", sealed=True))
+                emitted_seal_note = True
+            continue
+        if end_marker in line:
+            rows.append(_line_box(f"# sealed EI high-IP core ends at source line {line_no}", sealed=True))
+            sealed = False
+            continue
+        if sealed:
+            continue
+        rows.append(_line_box(line, generated=marker in line))
+    rows.extend([r"\end{Verbatim}", r"\end{tcolorbox}", ""])
+    return "\n".join(rows)
+
+
+def render(manifest_path: Path, out_path: Path) -> None:
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    listings = manifest.get("listings", [])
+    chunks = [
+        "% AUTO-GENERATED by paper/render_code_appendix.py; do not edit by hand.",
+        r"\subsection{Generated Lineage-Colored Listings}",
+        "The following listings are generated from paper/source_appendix_manifest.json.",
+        "",
+    ]
+    for entry in listings:
+        chunks.append(_render_listing(entry))
+    out_path.parent.mkdir(parents=True, exist_ok=True)
+    out_path.write_text("\n".join(chunks), encoding="utf-8")
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--manifest", type=Path, default=Path("paper/source_appendix_manifest.json"))
+    parser.add_argument("--out", type=Path, default=Path("paper/generated/code_appendix_rendered.tex"))
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    render(args.manifest, args.out)
+
+
+if __name__ == "__main__":
+    main()
