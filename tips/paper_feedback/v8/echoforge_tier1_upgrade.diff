@@ -0,0 +1,156 @@
+"""Public EI sparse-fusion wrapper for the paper appendix.
+
+Line-origin markers are intentionally explicit. The paper rendering tool uses
+`ORIGIN:GENERATIVE` comments to color generated-origin lines light blue. The
+sealed high-IP core is isolated between IP_CORE_START/IP_CORE_END markers and
+encrypted by `paper/seal_ei_ip_core.py` for controlled review.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import math
+import numpy as np
+
+
+@dataclass(frozen=True)
+class ComponentSpec:
+    audit_id: str
+    family: str
+    modality: str
+    calibrator: str
+    weight: float
+    score_column: str
+
+
+EI_COMPONENTS: tuple[ComponentSpec, ...] = (
+    ComponentSpec("C2", "passive_quality", "passive_rf", "geodesic_odds", 0.433, "c2_score"),  # ORIGIN:GENERATIVE
+    ComponentSpec("C4", "transport_geometry", "motion_geometry", "geodesic_odds", 0.292, "c4_score"),  # ORIGIN:GENERATIVE
+    ComponentSpec("C8", "passive_hypergraph", "passive_rf_graph", "geodesic_odds", 0.153, "c8_score"),  # ORIGIN:GENERATIVE
+    ComponentSpec("C1", "passive_quality", "passive_rf", "raw", 0.037, "c1_score"),
+    ComponentSpec("C5", "transport_geometry", "motion_geometry", "raw", 0.034, "c5_score"),
+    ComponentSpec("C3", "transport_residual", "mixed", "raw", 0.027, "c3_score"),  # ORIGIN:GENERATIVE
+    ComponentSpec("C6", "transport_residual", "mixed", "raw", 0.023, "c6_score"),  # ORIGIN:GENERATIVE
+)
+
+
+def _clip01(value: float) -> float:
+    return float(np.clip(value, 0.0, 1.0))
+
+
+def geodesic_odds(score: float, a: float, b: float, eps: float = 1.0e-6) -> float:
+    """Monotone odds calibrator used after sparse fusion."""
+    clipped = np.clip(score, eps, 1.0 - eps)
+    z = a * math.log(clipped / (1.0 - clipped)) + b
+    return float(1.0 / (1.0 + math.exp(-max(-40.0, min(40.0, z)))))
+
+
+def sparse_nonnegative_fusion(row: dict[str, float], components: tuple[ComponentSpec, ...] = EI_COMPONENTS) -> float:
+    """Sparse nonnegative late fusion over locked component scores."""
+    total_weight = sum(max(0.0, spec.weight) for spec in components)
+    if total_weight <= 0.0:
+        raise ValueError("component weights must have positive mass")
+    score = 0.0
+    for spec in components:
+        raw = _clip01(float(row.get(spec.score_column, 0.0)))
+        score += max(0.0, spec.weight) * raw / total_weight
+    return _clip01(score)
+
+
+def public_quality_gate(row: dict[str, float]) -> float:
+    """Visible guardrail: penalize stale, low-provenance, or contaminated cues."""
+    stale = _clip01(float(row.get("stale_track_penalty", 1.0)))
+    provenance = _clip01(float(row.get("source_provenance_quality", 1.0)))
+    rfi = _clip01(float(row.get("rfi_burst_flag", 0.0)))
+    missing = _clip01(float(row.get("passive_rf_missing", 0.0)))
+    return _clip01(stale * provenance * (1.0 - 0.35 * rfi) * (1.0 - 0.15 * missing))
+
+
+# IP_CORE_START
+def sealed_candidate_transform(row: dict[str, float]) -> dict[str, float]:
+    """High-IP transform core.
+
+    The exact transform expression and coefficient set are sealed in the paper
+    appendix. This public shim documents inputs/outputs without disclosing the
+    full expression tree. Authorized reviewers decrypt the ciphertext block and
+    compare the SHA-256 digest against the private source used at build time.
+    """
+    raise RuntimeError("sealed EI transform core; see paper/generated/ei_ip_core.enc.txt")
+# IP_CORE_END
+
+
+def ei_score(row: dict[str, float], *, odds_a: float, odds_b: float, threshold: float | None = None) -> dict[str, float | bool]:
+    """Score one holdout row after selection lock."""
+    fused = sparse_nonnegative_fusion(row)  # ORIGIN:GENERATIVE
+    gated = _clip01(fused * public_quality_gate(row))  # ORIGIN:GENERATIVE
+    probability = geodesic_odds(gated, odds_a, odds_b)  # ORIGIN:GENERATIVE
+    result: dict[str, float | bool] = {"score": probability, "fused": fused, "gated": gated}
+    if threshold is not None:
+        result["prediction"] = bool(probability >= threshold)
+    return result
+
+
+def recall_at_fpr(labels: np.ndarray, scores: np.ndarray, max_fpr: float = 0.01) -> float:
+    """Swept fixed-FPR recall diagnostic used by the paper KPI."""
+    labels = np.asarray(labels, dtype=np.int8)
+    scores = np.asarray(scores, dtype=np.float64)
+    positives = int(np.sum(labels == 1))
+    negatives = int(np.sum(labels == 0))
+    if positives == 0 or negatives == 0:
+        return float("nan")
+    order = np.argsort(-scores, kind="mergesort")
+    tp = 0
+    fp = 0
+    best = 0.0
+    idx = 0
+    sorted_scores = scores[order]
+    sorted_labels = labels[order]
+    while idx < len(sorted_scores):
+        threshold = sorted_scores[idx]
+        while idx < len(sorted_scores) and sorted_scores[idx] == threshold:
+            if sorted_labels[idx] == 1:
+                tp += 1
+            else:
+                fp += 1
+            idx += 1
+        if fp / negatives <= max_fpr:
+            best = max(best, tp / positives)
+    return float(best)
+
+
+def selected_threshold_counts(labels: np.ndarray, scores: np.ndarray, threshold: float) -> dict[str, int | float]:
+    """Selected-threshold counts are kept separate from swept fixed-FPR recall."""
+    pred = scores >= threshold
+    tp = int(np.sum((labels == 1) & pred))
+    fp = int(np.sum((labels == 0) & pred))
+    tn = int(np.sum((labels == 0) & ~pred))
+    fn = int(np.sum((labels == 1) & ~pred))
+    precision = tp / max(tp + fp, 1)
+    recall = tp / max(tp + fn, 1)
+    f1 = 2.0 * precision * recall / max(precision + recall, 1.0e-12)
+    return {"tp": tp, "fp": fp, "tn": tn, "fn": fn, "precision": precision, "recall": recall, "f1": f1}
