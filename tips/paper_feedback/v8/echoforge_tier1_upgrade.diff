index 0000000..tier1f2
--- /dev/null
+++ b/paper/seal_ei_ip_core.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Seal the highest-IP EI source block for the paper appendix.
+
+The script extracts lines between IP_CORE_START and IP_CORE_END, writes a
+SHA-256 digest, and encrypts the block with OpenSSL AES-256-CBC/PBKDF2. The
+passphrase is intentionally supplied outside Git via ECHOFORGE_EI_IP_PASSPHRASE.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+
+START = "IP_CORE_START"
+END = "IP_CORE_END"
+
+
+def extract_block(source: Path) -> str:
+    lines = source.read_text(encoding="utf-8").splitlines()
+    inside = False
+    block: list[str] = []
+    for line in lines:
+        if START in line:
+            inside = True
+            continue
+        if END in line:
+            inside = False
+            break
+        if inside:
+            block.append(line)
+    if not block:
+        raise SystemExit(f"no sealed block found between {START} and {END} in {source}")
+    return "\n".join(block) + "\n"
+
+
+def openssl_encrypt(plaintext: bytes, passphrase: str) -> bytes:
+    cmd = [
+        "openssl",
+        "enc",
+        "-aes-256-cbc",
+        "-salt",
+        "-pbkdf2",
+        "-iter",
+        "200000",
+        "-base64",
+        "-A",
+        "-pass",
+        "stdin",
+    ]
+    proc = subprocess.run(
+        cmd,
+        input=(passphrase + "\n").encode("utf-8") + plaintext,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+    )
+    if proc.returncode == 0 and proc.stdout:
+        return proc.stdout
+    raise RuntimeError(proc.stderr.decode("utf-8", errors="replace") or "openssl encryption failed")
+
+
+def fallback_seal(plaintext: bytes, passphrase: str) -> bytes:
+    """Fallback stream seal for environments without OpenSSL.
+
+    The paper validator should prefer OpenSSL output. This fallback still avoids
+    plaintext disclosure in draft builds but is explicitly marked as fallback.
+    """
+    salt = hashlib.sha256((passphrase + ":echoforge").encode()).digest()
+    key = hashlib.pbkdf2_hmac("sha256", passphrase.encode(), salt, 200_000, dklen=32)
+    stream = bytearray()
+    counter = 0
+    while len(stream) < len(plaintext):
+        stream.extend(hashlib.sha256(key + counter.to_bytes(8, "big")).digest())
+        counter += 1
+    ciphertext = bytes(a ^ b for a, b in zip(plaintext, stream))
+    return b"FALLBACK-XOR-SHA256:" + base64.b64encode(salt + ciphertext)
+
+
+def seal(source: Path, out_dir: Path, *, allow_fallback: bool) -> None:
+    passphrase = os.environ.get("ECHOFORGE_EI_IP_PASSPHRASE")
+    if not passphrase:
+        raise SystemExit("set ECHOFORGE_EI_IP_PASSPHRASE before sealing the EI IP core")
+    plaintext = extract_block(source).encode("utf-8")
+    digest = hashlib.sha256(plaintext).hexdigest()
+    out_dir.mkdir(parents=True, exist_ok=True)
+    (out_dir / "ei_ip_core.sha256.txt").write_text(digest + "\n", encoding="utf-8")
+    try:
+        ciphertext = openssl_encrypt(plaintext, passphrase)
+    except Exception as exc:
+        if not allow_fallback:
+            raise SystemExit(f"OpenSSL encryption failed and fallback disabled: {exc}") from exc
+        ciphertext = fallback_seal(plaintext, passphrase)
+    (out_dir / "ei_ip_core.enc.txt").write_bytes(ciphertext + b"\n")
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=Path("paper/listings/ei_sparse_fusion_public.py"))
+    parser.add_argument("--out-dir", type=Path, default=Path("paper/generated"))
+    parser.add_argument("--allow-fallback", action="store_true")
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    try:
+        seal(args.source, args.out_dir, allow_fallback=args.allow_fallback)
+    except Exception as exc:  # pragma: no cover - CLI guard
+        print(f"seal_ei_ip_core failed: {exc}", file=sys.stderr)
+        raise
+
+
+if __name__ == "__main__":
+    main()
