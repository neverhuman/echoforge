+"""Paper-facing ML control baselines for detector-view-only features."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import numpy as np
+
+
+DENIED_FIELDS = {
+    "label_id",
+    "is_positive",
+    "split_role",
+    "scenario_group_id",
+    "cv_fold",
+    "time_lock_id",
+    "target_id",
+    "generator_seed",
+}
+
+
+@dataclass(frozen=True)
+class Normalizer:
+    center: np.ndarray
+    scale: np.ndarray
+
+    @classmethod
+    def fit(cls, x: np.ndarray) -> "Normalizer":
+        center = np.nanmedian(x, axis=0)
+        q75 = np.nanpercentile(x, 75, axis=0)
+        q25 = np.nanpercentile(x, 25, axis=0)
+        scale = np.maximum(q75 - q25, 1.0e-6)
+        return cls(center=center, scale=scale)
+
+    def transform(self, x: np.ndarray) -> np.ndarray:
+        return np.nan_to_num((x - self.center) / self.scale, nan=0.0, posinf=0.0, neginf=0.0)
+
+
+def detector_matrix(rows: list[dict[str, str]], feature_names: list[str]) -> np.ndarray:
+    """Create a model matrix while enforcing the detector-view denylist."""
+    forbidden = sorted(set(feature_names) & DENIED_FIELDS)
+    if forbidden:
+        raise ValueError(f"forbidden model features: {forbidden}")
+    matrix = []
+    for row in rows:
+        matrix.append([float(row.get(name, 0.0) or 0.0) for name in feature_names])
+    return np.asarray(matrix, dtype=np.float64)
+
+
+def sigmoid(z: np.ndarray) -> np.ndarray:
+    return 1.0 / (1.0 + np.exp(-np.clip(z, -40.0, 40.0)))
+
+
+def fit_ridge_logistic(x: np.ndarray, y: np.ndarray, *, l2: float = 1.0, steps: int = 300) -> np.ndarray:
+    """Small deterministic logistic baseline used as a transparent ML control."""
+    x_aug = np.c_[np.ones(len(x)), x]
+    weights = np.zeros(x_aug.shape[1], dtype=np.float64)
+    lr = 0.05 / max(1.0, np.sqrt(x_aug.shape[1]))
+    for _ in range(steps):
+        p = sigmoid(x_aug @ weights)
+        grad = (x_aug.T @ (p - y)) / max(1, len(y))
+        grad[1:] += l2 * weights[1:] / max(1, len(y))
+        weights -= lr * grad
+    return weights
+
+
+def predict_ridge_logistic(x: np.ndarray, weights: np.ndarray) -> np.ndarray:
+    x_aug = np.c_[np.ones(len(x)), x]
+    return sigmoid(x_aug @ weights)
+
+
+def sequence_proxy_score(phase_scores: list[float]) -> float:
+    """Human sequence control: reward persistent elevation over three phase windows."""
+    if not phase_scores:
+        return 0.0
+    arr = np.asarray(phase_scores, dtype=np.float64)
+    persistence = float(np.mean(arr > np.nanmedian(arr)))
+    slope = float(np.clip(arr[-1] - arr[0], -1.0, 1.0)) if len(arr) >= 2 else 0.0
+    peak = float(np.nanmax(arr))
+    return float(np.clip(0.55 * peak + 0.25 * persistence + 0.20 * max(0.0, slope), 0.0, 1.0))
+
+
+def train_detector_view_controls(train_rows: list[dict[str, str]], feature_names: list[str]) -> tuple[Normalizer, np.ndarray]:
+    labels = np.asarray([int(row["label_id"]) for row in train_rows], dtype=np.float64)
+    x_raw = detector_matrix(train_rows, feature_names)
+    normalizer = Normalizer.fit(x_raw)
+    weights = fit_ridge_logistic(normalizer.transform(x_raw), labels)
+    return normalizer, weights
