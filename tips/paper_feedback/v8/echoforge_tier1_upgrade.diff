+"""Paper-facing classical radar baseline used for appendix disclosure.
+
+This reference implementation is intentionally compact. It mirrors the evidence
+contract in the paper: range-Doppler concentration, CFAR-style thresholding,
+MTD-style moving-target concentration, and M/N confirmation. It is not a vendor
+processor and must not be cited as sensor-parity code.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import numpy as np
+
+
+@dataclass(frozen=True)
+class CfarConfig:
+    guard: int = 1
+    train: int = 4
+    alpha: float = 8.0
+    order_statistic: float = 0.75
+
+
+def range_doppler_log_power(iq_cpi: np.ndarray) -> np.ndarray:
+    """Return normalized log-power range-Doppler proxy for one CPI."""
+    if iq_cpi.ndim != 2:
+        raise ValueError(f"expected [pulse, range] CPI, got shape={iq_cpi.shape}")
+    window_pulse = np.hanning(iq_cpi.shape[0])[:, None]
+    window_range = np.hanning(iq_cpi.shape[1])[None, :]
+    rd = np.fft.fftshift(np.fft.fft2(iq_cpi * window_pulse * window_range), axes=0)
+    power = np.log1p(np.abs(rd) ** 2)
+    denom = float(np.nanpercentile(power, 99.0) - np.nanpercentile(power, 5.0))
+    if denom <= 1.0e-12:
+        return np.zeros_like(power, dtype=np.float64)
+    return (power - np.nanpercentile(power, 5.0)) / denom
+
+
+def _training_cells(row: np.ndarray, center: int, cfg: CfarConfig) -> np.ndarray:
+    lo = max(0, center - cfg.guard - cfg.train)
+    hi = min(len(row), center + cfg.guard + cfg.train + 1)
+    guard_lo = max(0, center - cfg.guard)
+    guard_hi = min(len(row), center + cfg.guard + 1)
+    cells = np.concatenate([row[lo:guard_lo], row[guard_hi:hi]])
+    return cells[np.isfinite(cells)]
+
+
+def ca_cfar_score(rd_power: np.ndarray, cfg: CfarConfig = CfarConfig()) -> float:
+    """A conservative CA-CFAR envelope score over the range-Doppler map."""
+    detections = 0
+    tested = 0
+    for doppler_idx in range(rd_power.shape[0]):
+        row = rd_power[doppler_idx]
+        for range_idx, value in enumerate(row):
+            cells = _training_cells(row, range_idx, cfg)
+            if len(cells) < max(2, cfg.train):
+                continue
+            threshold = float(np.mean(cells) * cfg.alpha)
+            detections += int(value > threshold)
+            tested += 1
+    return float(detections / max(tested, 1))
+
+
+def os_cfar_score(rd_power: np.ndarray, cfg: CfarConfig = CfarConfig()) -> float:
+    """OS-CFAR style tail score; robust to a few contaminated training cells."""
+    exceedances = []
+    quantile = min(max(cfg.order_statistic, 0.05), 0.95)
+    for doppler_idx in range(rd_power.shape[0]):
+        row = rd_power[doppler_idx]
+        for range_idx, value in enumerate(row):
+            cells = _training_cells(row, range_idx, cfg)
+            if len(cells) < max(2, cfg.train):
+                continue
+            threshold = float(np.quantile(cells, quantile) * cfg.alpha)
+            exceedances.append(max(0.0, float(value - threshold)))
+    return float(np.mean(exceedances)) if exceedances else 0.0
+
+
+def mtd_concentration(rd_power: np.ndarray) -> float:
+    """Measure whether power is concentrated away from the zero-Doppler ridge."""
+    if rd_power.size == 0:
+        return 0.0
+    doppler_bins = np.arange(rd_power.shape[0]) - (rd_power.shape[0] // 2)
+    moving_mask = np.abs(doppler_bins) >= 2
+    moving_power = float(np.sum(rd_power[moving_mask, :]))
+    total_power = float(np.sum(rd_power) + 1.0e-12)
+    return moving_power / total_power
+
+
+def mn_confirmation(scores: list[float], m: int = 2, n: int = 3, threshold: float = 0.10) -> float:
+    """M/N confirmation proxy over adjacent CPI-level detector scores."""
+    if n <= 0 or m <= 0 or m > n:
+        raise ValueError("require 0 < m <= n")
+    if len(scores) < n:
+        return 0.0
+    windows = [scores[i : i + n] for i in range(0, len(scores) - n + 1)]
+    confirmed = [sum(score >= threshold for score in window) >= m for window in windows]
+    return float(np.mean(confirmed))
+
+
+def classical_radar_branch_score(iq_cpis: list[np.ndarray]) -> float:
+    """Aggregate a human-engineered radar score for one phase record."""
+    if not iq_cpis:
+        return 0.0
+    cfar_values = []
+    os_values = []
+    mtd_values = []
+    for cpi in iq_cpis:
+        rd = range_doppler_log_power(cpi)
+        cfar_values.append(ca_cfar_score(rd))
+        os_values.append(os_cfar_score(rd))
+        mtd_values.append(mtd_concentration(rd))
+    confirm = mn_confirmation(cfar_values, m=2, n=min(3, len(cfar_values)), threshold=0.02)
+    score = 0.35 * np.mean(cfar_values) + 0.20 * np.mean(os_values) + 0.30 * np.mean(mtd_values) + 0.15 * confirm
+    return float(np.clip(score, 0.0, 1.0))
