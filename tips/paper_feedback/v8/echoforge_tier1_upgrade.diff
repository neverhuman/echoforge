+"""Accepted human-engineered prior-fusion comparator for the paper appendix."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import math
+import numpy as np
+
+
+@dataclass(frozen=True)
+class FusionWeights:
+    xku: float = 0.28
+    sband: float = 0.13
+    gbad: float = 0.12
+    acoustic: float = 0.10
+    passive_rf: float = 0.22
+    source_quality: float = 0.15
+
+
+def _clip01(value: float) -> float:
+    return float(np.clip(value, 0.0, 1.0))
+
+
+def stale_track_penalty(age_s: float, revisit_s: float) -> float:
+    if revisit_s <= 0.0:
+        return 1.0
+    return float(np.exp(-max(0.0, age_s) / (2.0 * revisit_s)))
+
+
+def passive_rf_quality(row: dict[str, float]) -> float:
+    missing = float(row.get("passive_rf_missing", 0.0))
+    rfi = float(row.get("rfi_burst_flag", 0.0))
+    provenance = float(row.get("passive_rf_provenance_quality", 0.0))
+    return _clip01((1.0 - missing) * (1.0 - 0.55 * rfi) * provenance)
+
+
+def cross_sensor_confirmation(row: dict[str, float]) -> float:
+    radar_votes = [
+        row.get("high_resolution_xku_cuas", 0.0),
+        row.get("tactical_s_band_aesa", 0.0),
+        row.get("gbad_3d4d_cueing", 0.0),
+    ]
+    cue_votes = [row.get("distributed_acoustic_cue", 0.0), passive_rf_quality(row)]
+    radar_support = float(np.mean([score > 0.5 for score in radar_votes]))
+    cue_support = float(np.mean([score > 0.5 for score in cue_votes]))
+    return _clip01(0.65 * radar_support + 0.35 * cue_support)
+
+
+def layered_fusion_score(row: dict[str, float], weights: FusionWeights = FusionWeights()) -> float:
+    """Accepted-practice comparator: interpretable weighted late fusion."""
+    source_quality = passive_rf_quality(row)
+    base = (
+        weights.xku * row.get("high_resolution_xku_cuas", 0.0)
+        + weights.sband * row.get("tactical_s_band_aesa", 0.0)
+        + weights.gbad * row.get("gbad_3d4d_cueing", 0.0)
+        + weights.acoustic * row.get("distributed_acoustic_cue", 0.0)
+        + weights.passive_rf * row.get("passive_rf_score", source_quality)
+        + weights.source_quality * source_quality
+    )
+    confirm = cross_sensor_confirmation(row)
+    stale = stale_track_penalty(row.get("track_age_s", 0.0), row.get("scan_revisit_s", 1.0))
+    clutter_stress = row.get("clutter_stress", 0.0)
+    score = (0.82 * base + 0.18 * confirm) * stale - 0.12 * clutter_stress
+    return _clip01(score)
+
+
+def best_train_cv_threshold(labels: np.ndarray, scores: np.ndarray) -> float:
+    """Select threshold from train/CV only by max F1; holdout is never used."""
+    best_threshold = 1.0
+    best_f1 = -1.0
+    for threshold in np.unique(np.round(scores, 6)):
+        pred = scores >= threshold
+        tp = float(np.sum((labels == 1) & pred))
+        fp = float(np.sum((labels == 0) & pred))
+        fn = float(np.sum((labels == 1) & ~pred))
+        precision = tp / max(tp + fp, 1.0)
+        recall = tp / max(tp + fn, 1.0)
+        f1 = 2.0 * precision * recall / max(precision + recall, 1.0e-12)
+        if f1 > best_f1:
+            best_f1 = f1
+            best_threshold = float(threshold)
+    return best_threshold
+
+
+def logit_calibrate(scores: np.ndarray, a: float, b: float, eps: float = 1.0e-6) -> np.ndarray:
+    clipped = np.clip(scores, eps, 1.0 - eps)
+    z = a * np.log(clipped / (1.0 - clipped)) + b
+    return 1.0 / (1.0 + np.exp(-np.clip(z, -40.0, 40.0)))
