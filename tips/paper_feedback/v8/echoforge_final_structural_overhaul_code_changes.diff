diff --git a/paper/generate_source_appendix.py b/paper/generate_source_appendix.py
new file mode 100755
--- /dev/null
+++ b/paper/generate_source_appendix.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+import argparse, ast, base64, hashlib, hmac, json, os
+from pathlib import Path
+from typing import Any
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+DEFAULT_MANIFEST = REPO_ROOT / "paper" / "source_appendix_manifest.json"
+DEFAULT_OUTPUT = REPO_ROOT / "paper" / "source_code_appendix.tex"
+
+def tex_escape(text: str) -> str:
+    repl = {"\\":r"\textbackslash{}","{":r"\{","}":r"\}","$":r"\$","&":r"\&","%":r"\%","#":r"\#","_":r"\_","~":r"\textasciitilde{}","^":r"\textasciicircum{}"}
+    return "".join(repl.get(ch, ch) for ch in text)
+
+def find_spans(path: Path, symbols: list[str]) -> list[tuple[int,int,str]]:
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    spans = []
+    for node in ast.walk(tree):
+        if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)) and node.name in symbols:
+            spans.append((int(node.lineno), int(getattr(node,"end_lineno",node.lineno)), node.name))
+    missing = sorted(set(symbols)-{n for _,_,n in spans})
+    if missing: raise ValueError(f"{path}: missing {missing}")
+    return sorted(spans)
+
+def src_line_macro(origin: str) -> str:
+    return "SrcLineGen" if origin == "generative" else "SrcLineHuman"
+
+def emit_source_block(repo: Path, block: dict[str,Any]) -> str:
+    path = repo / block["path"]
+    lines = path.read_text(encoding="utf-8").splitlines()
+    rel = path.relative_to(repo).as_posix()
+    out = [f"\\subsubsection*{{{tex_escape(block['title'])}}}", f"\\noindent\\textit{{Source: \\texttt{{{tex_escape(rel)}}}.}}"]
+    macro = src_line_macro(block.get("origin","human"))
+    for start,end,name in find_spans(path, [str(s) for s in block["symbols"]]):
+        out.append(f"\\paragraph{{{tex_escape(name)}}}")
+        for number in range(start, end+1):
+            payload = tex_escape(f"{number:04d}  {lines[number-1]}")
+            out.append(f"\\{macro}{{{payload}}}")
+    return "\n".join(out)
+
+def seal_payload(plaintext: bytes, key_text: str) -> dict[str,str]:
+    key = hashlib.sha256(key_text.encode()).digest()
+    nonce = os.urandom(16)
+    stream = b""
+    ctr = 0
+    while len(stream) < len(plaintext):
+        stream += hashlib.sha256(key + nonce + ctr.to_bytes(8,"big")).digest(); ctr += 1
+    ciphertext = bytes(a^b for a,b in zip(plaintext, stream[:len(plaintext)]))
+    return {"scheme":"appendix SHA256-XOR-HMAC seal; use AES-GCM for formal IP escrow","nonce_b64":base64.b64encode(nonce).decode(),"ciphertext_b64":base64.b64encode(ciphertext).decode(),"hmac_sha256_b64":base64.b64encode(hmac.new(key, nonce+ciphertext, hashlib.sha256).digest()).decode(),"plaintext_sha256":hashlib.sha256(plaintext).hexdigest()}
+
+def emit_ip_block(repo: Path, manifest: dict[str,Any]) -> str:
+    spec = manifest.get("ip_excerpt",{})
+    if not spec: return ""
+    path = repo / spec["path"]
+    lines = path.read_text(encoding="utf-8").splitlines()
+    selected = []
+    for start,end,name in find_spans(path, [str(s) for s in spec.get("selectors",[])]):
+        selected.append(f"# --- {name}: lines {start}-{end} ---")
+        selected.extend(lines[start-1:end])
+    key = os.environ.get(str(spec.get("encrypt_env_var","ECHOFORGE_IP_APPENDIX_KEY")), "")
+    out = ["\\subsection{Optional Sealed IP Excerpt}", "This sealed block is a duplicate review artifact. It is not needed to reproduce paper results."]
+    if not key:
+        out.append(f"\\noindent\\textbf{{Not generated.}} Set \\texttt{{{tex_escape(spec.get('encrypt_env_var','ECHOFORGE_IP_APPENDIX_KEY'))}}} to emit ciphertext.")
+    else:
+        sealed = seal_payload("\n".join(selected).encode("utf-8"), key)
+        out += ["\\begin{lstlisting}[style=EchoForgeCode]", json.dumps(sealed, indent=2), "\\end{lstlisting}"]
+    return "\n".join(out)
+
+def main() -> int:
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo-root", type=Path, default=REPO_ROOT)
+    p.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
+    p.add_argument("--out", type=Path, default=DEFAULT_OUTPUT)
+    args = p.parse_args()
+    manifest = json.loads(args.manifest.read_text(encoding="utf-8"))
+    out = [
+        "\\subsection{Source Listing Color Key}",
+        "Color key: \\SrcKeyHuman{} and \\SrcKeyGen{}. Yellow sealed excerpts are optional IP-review duplicates and are not required for reproducibility.",
+        "\\newcommand{\\SrcLineBase}[2]{\\noindent\\colorbox{#1}{\\parbox{\\dimexpr\\linewidth-2\\fboxsep}{\\ttfamily\\scriptsize #2}}\\par}",
+        "\\newcommand{\\SrcLineHuman}[1]{\\SrcLineBase{SrcHuman}{#1}}",
+        "\\newcommand{\\SrcLineGen}[1]{\\SrcLineBase{SrcGen}{#1}}",
+        "\\subsection{Human-Engineered Comparator Source}"
+    ]
+    out += [emit_source_block(args.repo_root, b) for b in manifest["blocks"] if b.get("origin") != "generative"]
+    out.append("\\subsection{Engineered Intelligence Source}")
+    out += [emit_source_block(args.repo_root, b) for b in manifest["blocks"] if b.get("origin") == "generative"]
+    out.append(emit_ip_block(args.repo_root, manifest))
+    args.out.write_text("\n".join(out)+"\n", encoding="utf-8")
+    print(f"wrote {args.out}")
+    return 0
+if __name__ == "__main__":
+    raise SystemExit(main())
