index 0000000..tier1v4
--- /dev/null
+++ b/paper/build_code_appendix.py
@@ -0,0 +1,228 @@
+#!/usr/bin/env python3
+"""Generate the EchoForge source-code appendix.
+
+The generated TeX includes syntax-highlighted baseline/fusion code and an
+origin-colored EI excerpt.  A small highest-IP excerpt can be escrow-encrypted
+with ECHOFORGE_CODE_APPENDIX_KEY.  If no key is provided, the excerpt is
+replaced by a hash-only redaction so the paper remains buildable.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+import os
+import re
+from pathlib import Path
+from typing import Any
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+DEFAULT_MANIFEST = REPO_ROOT / "paper" / "code_appendix_manifest.json"
+DEFAULT_TEX = REPO_ROOT / "paper" / "generated_code_appendix.tex"
+DEFAULT_META = REPO_ROOT / "paper" / "encrypted_ip_excerpt.json"
+
+
+def _read_json(path: Path) -> dict[str, Any]:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def _tex_escape(value: str) -> str:
+    replacements = {
+        "\\": r"\textbackslash{}",
+        "&": r"\&",
+        "%": r"\%",
+        "$": r"\$",
+        "#": r"\#",
+        "_": r"\_",
+        "{": r"\{",
+        "}": r"\}",
+        "~": r"\textasciitilde{}",
+        "^": r"\textasciicircum{}",
+    }
+    return "".join(replacements.get(ch, ch) for ch in value.rstrip("\n"))
+
+
+def _lst_block(title: str, path: str, text: str) -> str:
+    escaped_title = _tex_escape(f"{title} ({path})")
+    return (
+        f"\\begin{{EchoCodeBox}}{{{escaped_title}}}\n"
+        f"{text.rstrip()}\n"
+        "\\end{EchoCodeBox}\n"
+    )
+
+
+def _origin_color(origin: str) -> str:
+    if origin == "generative":
+        return "CodeBlue"
+    if origin == "encrypted":
+        return "CodeIp"
+    return "CodeHuman"
+
+
+def _classify_line(line: str, generative_re: re.Pattern[str] | None, encrypt_re: re.Pattern[str] | None) -> str:
+    if encrypt_re is not None and encrypt_re.search(line):
+        return "encrypted"
+    if generative_re is not None and generative_re.search(line):
+        return "generative"
+    return "human"
+
+
+def _xor_stream_cipher(payload: bytes, key: bytes) -> bytes:
+    out = bytearray()
+    counter = 0
+    while len(out) < len(payload):
+        block = hashlib.sha256(key + counter.to_bytes(8, "big")).digest()
+        out.extend(block)
+        counter += 1
+    return bytes(a ^ b for a, b in zip(payload, out[: len(payload)]))
+
+
+def _encrypt_excerpt(excerpt: str) -> dict[str, Any]:
+    digest = hashlib.sha256(excerpt.encode("utf-8")).hexdigest()
+    key = os.environ.get("ECHOFORGE_CODE_APPENDIX_KEY")
+    if not key:
+        return {
+            "status": "hash_only_no_key",
+            "sha256": digest,
+            "ciphertext_b64": "",
+            "note": "Set ECHOFORGE_CODE_APPENDIX_KEY to emit an escrow-encrypted excerpt.",
+        }
+    key_bytes = hashlib.sha256(key.encode("utf-8")).digest()
+    ciphertext = _xor_stream_cipher(excerpt.encode("utf-8"), key_bytes)
+    return {
+        "status": "encrypted_with_env_key",
+        "sha256": digest,
+        "cipher": "sha256-stream-xor escrow envelope",
+        "ciphertext_b64": base64.b64encode(ciphertext).decode("ascii"),
+        "note": "Escrow excerpt is not required to reproduce the published KPI.",
+    }
+
+
+def _origin_colored_block(title: str, path: str, text: str, generative_pattern: str | None, encrypt_pattern: str | None) -> tuple[str, str]:
+    generative_re = re.compile(generative_pattern, re.IGNORECASE) if generative_pattern else None
+    encrypt_re = re.compile(encrypt_pattern, re.IGNORECASE) if encrypt_pattern else None
+    lines = text.splitlines()
+    encrypted_lines: list[str] = []
+    output = [
+        f"\\subsection{{{_tex_escape(title)}}}\n",
+        f"\\textit{{Source:}} \\texttt{{{_tex_escape(path)}}}. Light-blue rows are generative/evolved-search infrastructure; red rows are IP-escrowed excerpt markers.\\par\n",
+    ]
+    for idx, line in enumerate(lines, start=1):
+        origin = _classify_line(line, generative_re, encrypt_re)
+        if origin == "encrypted":
+            encrypted_lines.append(f"{idx:04d}: {line}")
+            shown = "[IP-escrow excerpt encrypted; see encrypted_ip_excerpt.json and SHA-256 digest]"
+        else:
+            shown = line
+        color = _origin_color(origin)
+        output.append(f"\\OriginLine{{{color}}}{{{idx:04d}}}{{{_tex_escape(shown)}}}")
+    return "\n".join(output) + "\n", "\n".join(encrypted_lines)
+
+
+def _section_text(section: dict[str, Any]) -> str:
+    rel = str(section["path"])
+    path = REPO_ROOT / rel
+    if not path.is_file():
+        return f"% Missing source file: {rel}\n"
+    text = path.read_text(encoding="utf-8")
+    if section.get("include") == "excerpt":
+        max_lines = int(section.get("max_lines", 220))
+        text = "\n".join(text.splitlines()[:max_lines])
+    if section.get("origin") == "mixed_human_generative":
+        block, encrypted = _origin_colored_block(
+            str(section["title"]),
+            rel,
+            text,
+            section.get("generative_hint_regex"),
+            section.get("encrypt_hint_regex"),
+        )
+        section["_encrypted_excerpt"] = encrypted
+        return block
+    return _lst_block(str(section["title"]), rel, text)
+
+
+def build(manifest_path: Path, tex_path: Path, meta_path: Path) -> None:
+    manifest = _read_json(manifest_path)
+    sections = manifest.get("sections", [])
+    tex_chunks = [
+        "% Generated by paper/build_code_appendix.py; do not edit by hand.\n",
+        "\\subsection{Code Appendix Key}\n",
+        "Human-standard source is shown with normal syntax highlighting. EI source is line-colored: white = human-standard scaffolding, light blue = generative/evolved-search infrastructure, light red = IP-escrow marker. Encrypted excerpts are not required to reproduce the paper KPI.\\par\n",
+    ]
+    encrypted_payload = []
+    for section in sections:
+        tex_chunks.append(_section_text(section))
+        encrypted = section.get("_encrypted_excerpt", "")
+        if encrypted:
+            encrypted_payload.append({
+                "title": section.get("title"),
+                "path": section.get("path"),
+                "envelope": _encrypt_excerpt(encrypted),
+            })
+    if not encrypted_payload:
+        encrypted_payload.append({"title": "none", "path": "", "envelope": _encrypt_excerpt("")})
+    tex_path.write_text("\n".join(tex_chunks), encoding="utf-8")
+    meta_path.write_text(json.dumps({"version": manifest.get("version"), "encrypted_excerpts": encrypted_payload}, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
+    parser.add_argument("--write-tex", type=Path, default=DEFAULT_TEX)
+    parser.add_argument("--metadata", type=Path, default=DEFAULT_META)
+    args = parser.parse_args()
+    build(args.manifest, args.write_tex, args.metadata)
+    print(f"wrote {args.write_tex} and {args.metadata}")
+
+
+if __name__ == "__main__":
+    main()
