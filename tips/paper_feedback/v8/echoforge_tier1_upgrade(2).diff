+def _encrypted_ip_redaction_rows() -> list[dict[str, Any]]:
+    """Create an appendix-safe encrypted-redaction notice.
+
+    The key is never committed.  To produce a ciphertext blob in CI/release,
+    set ECHOFORGE_IP_REDACTION_KEY to at least 32 bytes.  Without it the paper
+    still contains the checksum and a clear statement that the excerpt is
+    intentionally withheld from the public appendix.
+    """
+
+    key = os.environ.get("ECHOFORGE_IP_REDACTION_KEY", "")
+    target = next((row for row in APPENDIX_CODE_TARGETS if row["origin"] == "generative_ai_inspired"), None)
+    if target is None:
+        return []
+    source_path = REPO_ROOT / target["path"]
+    source_text = _read_text(source_path)
+    if not source_text:
+        return [
+            {
+                "method_id": target["method_id"],
+                "source_path": target["path"],
+                "encrypted_fraction": "",
+                "ciphertext_path": "",
+                "sha256": "",
+                "status": "source_missing",
+                "appendix_note": "No EI source file was present at the expected path; update APPENDIX_CODE_TARGETS.",
+            }
+        ]
+    lines = source_text.splitlines()
+    start = max(0, int(len(lines) * 0.42))
+    span = max(8, int(len(lines) * 0.12))
+    excerpt = "\n".join(lines[start : start + span]) + "\n"
+    digest = __import__("hashlib").sha256(excerpt.encode("utf-8")).hexdigest()
+    ciphertext_path = DEFAULT_OUT_ROOT / "encrypted_ei_ip_excerpt.b64"
+    if len(key.encode("utf-8")) >= 32:
+        import base64
+        import hashlib
+
+        seed = hashlib.sha256(key.encode("utf-8")).digest()
+        stream = bytearray()
+        counter = 0
+        while len(stream) < len(excerpt.encode("utf-8")):
+            stream.extend(hashlib.sha256(seed + counter.to_bytes(8, "big")).digest())
+            counter += 1
+        plaintext = excerpt.encode("utf-8")
+        cipher = bytes(value ^ stream[idx] for idx, value in enumerate(plaintext))
+        ciphertext_path.parent.mkdir(parents=True, exist_ok=True)
+        ciphertext_path.write_text(base64.b64encode(cipher).decode("ascii") + "\n", encoding="utf-8")
+        status = "encrypted"
+    else:
+        status = "key_missing_digest_only"
+    return [
+        {
+            "method_id": target["method_id"],
+            "source_path": target["path"],
+            "encrypted_fraction": f"{span / max(len(lines), 1):.3f}",
+            "ciphertext_path": str(ciphertext_path) if status == "encrypted" else "",
+            "sha256": digest,
+            "status": status,
+            "appendix_note": "The highest-IP EI excerpt is redacted from the public appendix; the digest identifies the exact excerpt and ciphertext is generated only when ECHOFORGE_IP_REDACTION_KEY is supplied.",
+        }
+    ]
+

