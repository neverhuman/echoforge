+#!/usr/bin/env python3
+"""Generate a color-coded source-code appendix for the EchoForge paper."""
+
+from __future__ import annotations
+
+import argparse, base64, hashlib, json, os
+from dataclasses import dataclass
+from pathlib import Path
+
+DEFAULT_TARGETS = [
+    {"id":"classical_radar","title":"Accepted human approach 1: classical radar branch processing","path_candidates":["detection/run_main_run_detectors.py","detection/detectors/classical_radar_processing.py"],"origin":"human","description":"CFAR/MTD-style branch scores and radar summary features."},
+    {"id":"tabular_ml","title":"Accepted human approach 2: tabular ML baseline","path_candidates":["detection/run_main_run_detectors.py","detection/detectors/ml_detector_baselines.py"],"origin":"human","description":"Conventional tabular learned baseline on detector-facing features."},
+    {"id":"sequence_ml","title":"Accepted human approach 3: sequence proxy baseline","path_candidates":["detection/run_main_run_detectors.py","detection/detectors/ml_detector_baselines.py"],"origin":"human","description":"Sequence-style learned proxy using phase-aware detector summaries."},
+    {"id":"prior_fusion","title":"Accepted human fusion approach: layered fusion C2","path_candidates":["detection/run_main_run_detectors.py","detection/detectors/layered_fusion_c2.py"],"origin":"human","description":"Human-engineered late fusion comparator with train/CV thresholding."},
+    {"id":"ei_candidate","title":"Engineered Intelligence approach: evolved sparse calibrated fusion","path_candidates":["detection/run_advanced_main_run_detectors.py","detection/advanced_main_run_detectors.py"],"origin":"generative","description":"Train/CV candidate discovery, sparse nonnegative weights, geodesic odds calibration, and selection lock.","protected_fraction":0.15,"protected_reason":"highest-IP objective composition and candidate-scoring loop"},
+]
+
+@dataclass(frozen=True)
+class Target:
+    id: str
+    title: str
+    path: Path
+    origin: str
+    description: str
+    protected_fraction: float = 0.0
+    protected_reason: str = ""
+
+def esc(s: str) -> str:
+    return (s.replace('\\', r'\textbackslash{}').replace('&', r'\&').replace('%', r'\%')
+             .replace('$', r'\$').replace('#', r'\#').replace('_', r'\_')
+             .replace('{', r'\{').replace('}', r'\}').replace('~', r'\textasciitilde{}')
+             .replace('^', r'\textasciicircum{}'))
+
+def read_json(path: Path) -> dict:
+    if not path.exists():
+        return {}
+    try:
+        data = json.loads(path.read_text(encoding='utf-8'))
+        return data if isinstance(data, dict) else {}
+    except json.JSONDecodeError:
+        return {}
+
+def targets(repo: Path) -> list[Target]:
+    out = []
+    for item in DEFAULT_TARGETS:
+        candidates = [repo / p for p in item['path_candidates']]
+        path = next((p for p in candidates if p.exists()), candidates[0])
+        out.append(Target(item['id'], item['title'], path, item['origin'], item['description'], float(item.get('protected_fraction',0)), item.get('protected_reason','')))
+    return out
+
+def protected_range(lines: list[str], frac: float) -> range:
+    if frac <= 0 or not lines:
+        return range(0)
+    count = max(1, int(round(len(lines) * frac)))
+    window = min(max(8, count), len(lines))
+    scores = []
+    for i in range(0, max(1, len(lines)-window+1)):
+        chunk = '\n'.join(lines[i:i+window])
+        score = len(chunk) + 5 * sum(chunk.count(ch) for ch in '()[]{}=+-*/<>_.')
+        scores.append((score, i))
+    _score, start = max(scores)
+    return range(start + 1, min(len(lines), start + count) + 1)
+
+def protected_payload(text: str, key: str | None) -> str:
+    digest = hashlib.sha256(text.encode()).hexdigest()
+    if not key:
+        return 'SHA256:' + digest
+    key_bytes = hashlib.sha256(key.encode()).digest()
+    raw = text.encode()
+    encrypted = bytes(b ^ key_bytes[i % len(key_bytes)] for i, b in enumerate(raw))
+    return 'XOR-B64:' + base64.b64encode(encrypted).decode() + ':SHA256:' + digest
+
+def emit_target(t: Target, repo: Path, key: str | None) -> tuple[str, dict]:
+    rel = t.path.relative_to(repo) if t.path.exists() else t.path
+    if not t.path.exists():
+        return f"\\subsection{{{esc(t.title)}}}\nMissing source: \\texttt{{{esc(str(rel))}}}\n", {"id":t.id,"path":str(rel),"status":"missing"}
+    lines = t.path.read_text(encoding='utf-8', errors='replace').splitlines()
+    pr = protected_range(lines, t.protected_fraction)
+    tex = [f"\\subsection{{{esc(t.title)}}}", f"\\textbf{{Path:}} \\texttt{{{esc(str(rel))}}}. \\textbf{{Purpose:}} {esc(t.description)}.", "\\begin{flushleft}\\scriptsize\\ttfamily"]
+    protected_lines = []
+    for no, line in enumerate(lines, 1):
+        if no in pr:
+            protected_lines.append(line)
+            continue
+        color = 'EchoCodeGen' if t.origin == 'generative' else 'EchoCodeHuman'
+        tex.append(f"\\colorbox{{{color}}}{{\\parbox{{0.96\\linewidth}}{{{esc(f'{no:04d}: {line}')}}}}}\\\\")
+    protected = []
+    if protected_lines:
+        payload = '\n'.join(protected_lines)
+        tex.append("\\colorbox{EchoCodeLocked}{\\parbox{0.96\\linewidth}{" + esc(f"[IP-protected excerpt; reason={t.protected_reason}; {protected_payload(payload, key)}]") + "}}\\\\")
+        protected.append({"start_line": pr.start, "end_line": pr.stop - 1, "sha256": hashlib.sha256(payload.encode()).hexdigest(), "reason": t.protected_reason})
+    tex.append("\\end{flushleft}")
+    return '\n'.join(tex), {"id":t.id,"path":str(rel),"line_count":len(lines),"origin":t.origin,"protected_ranges":protected,"status":"included"}
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--repo-root', type=Path, default=Path(__file__).resolve().parents[1])
+    parser.add_argument('--paper-evidence-root', type=Path, default=Path('outputs/paper-evidence/major-upgrade-v1'))
+    parser.add_argument('--out', type=Path, default=Path('paper/generated/source_code_appendix.tex'))
+    parser.add_argument('--manifest-out', type=Path, default=Path('outputs/paper-evidence/major-upgrade-v1/code_appendix_manifest.json'))
+    parser.add_argument('--strict', action='store_true')
+    args = parser.parse_args()
+    repo = args.repo_root.resolve()
+    parts = ['% Auto-generated by paper/generate_source_appendix.py', 'Human/reviewed and generative-origin-assisted lines are background-coded.']
+    records = []
+    for t in targets(repo):
+        tex, record = emit_target(t, repo, os.environ.get('ECHOFORGE_IP_APPENDIX_KEY'))
+        if args.strict and record['status'] != 'included':
+            raise FileNotFoundError(record['path'])
+        parts.append(tex)
+        records.append(record)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text('\n\n'.join(parts) + '\n', encoding='utf-8')
+    args.manifest_out.parent.mkdir(parents=True, exist_ok=True)
+    args.manifest_out.write_text(json.dumps({'targets': records}, indent=2, sort_keys=True) + '\n', encoding='utf-8')
+    return 0
+
+if __name__ == '__main__':
+    raise SystemExit(main())

