+import argparse
+import hashlib
+from dataclasses import dataclass
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+OUT_DIR = Path(__file__).resolve().parent
+
+@dataclass(frozen=True)
+class SourceBlock:
+    title: str
+    path: Path
+    language: str
+    provenance: str
+    start_line: int | None = None
+    end_line: int | None = None
+
+SOURCE_BLOCKS = [
+    SourceBlock("Classical radar and evidence processing", REPO_ROOT / "detection" / "paper_evidence_major_upgrade_v1.py", "Python", "human-audited evidence summarizer", 1, 220),
+    SourceBlock("Figure and evidence rendering pipeline", REPO_ROOT / "paper" / "generate_figures_major_upgrade_v2.py", "Python", "human-audited visualization pipeline", 1, 260),
+    SourceBlock("Paper validation guardrails", REPO_ROOT / "paper" / "validate_paper.py", "Python", "human-authored validation rules", 1, 220),
+    SourceBlock("Visual validation guardrails", REPO_ROOT / "paper" / "validate_visuals.py", "Python", "human-authored visual regression checks", 1, 200),
+]
+
+HIGH_IP_RANGES = [
+    {"name": "EI candidate discovery and sparse calibrated fusion", "path": "detection/paper_evidence_major_upgrade_v1.py", "reason": "score-family decomposition, train/CV-only controls, and sparse calibrated fusion", "policy": "reviewable source plus SHA-256 digest; do not use encrypted code as a substitute for audit"},
+    {"name": "Selection-lock and holdout metric basis", "path": "detection/paper_evidence_major_upgrade_v1.py", "reason": "interface between algorithm search and one-pass holdout evidence", "policy": "keep source reviewable; publish integrity digest"},
+]
+
+def _esc(text: str) -> str:
+    return text.replace("\\", r"\textbackslash{}").replace("&", r"\&").replace("%", r"\%").replace("$", r"\$").replace("#", r"\#").replace("_", r"\_").replace("{", r"\{").replace("}", r"\}")
+
+def _slice(path: Path, start: int | None, end: int | None) -> str:
+    if not path.exists():
+        return f"# Missing source file: {path}\n"
+    lines = path.read_text(encoding="utf-8").splitlines()
+    return "\n".join(lines[max((start or 1) - 1, 0): min(end or len(lines), len(lines))]) + "\n"
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else "missing"
+
+def write_cli(path: Path) -> None:
+    path.write_text(r"""\noindent The commands below rebuild the paper-facing evidence bundle, figures, source-code appendix, PDF, and validation checks.
+
+\begin{lstlisting}[style=echoforgecode,language=bash,caption={EchoForge paper rebuild commands}]
+python detection/paper_evidence_major_upgrade_v1.py --force
+python paper/generate_figures_major_upgrade_v2.py --strict
+python paper/generate_appendix_code_listings.py
+python paper/validate_visuals.py
+./paper/build.sh
+python paper/validate_paper.py \
+  --tex paper/echoforge_ieee.tex \
+  --bib paper/references.bib \
+  --pdf paper/echoforge_ieee.pdf \
+  --figures-dir paper/figures \
+  --paper-evidence-root outputs/paper-evidence/major-upgrade-v1
+\end{lstlisting}
+""", encoding="utf-8")
+
+def write_sources(path: Path) -> None:
+    chunks = ["\\noindent\\textbf{Provenance key.} Listings are generated from repository source. High-IP sections are identified by digest rather than encrypted; encrypted code is not reviewable and would weaken the strict-open claim.\n\n"]
+    chunks.append("\\begin{table*}[h]\n\\centering\n\\small\n\\caption{High-IP Source Ranges and Review Policy}\n\\begin{tabular}{@{}p{0.22\\textwidth}p{0.20\\textwidth}p{0.26\\textwidth}p{0.22\\textwidth}@{}}\n\\toprule\nRange & File & Why it matters & Review policy \\\\\n\\midrule\n")
+    for row in HIGH_IP_RANGES:
+        chunks.append(f"{_esc(row['name'])} & \\texttt{{{_esc(row['path'])}}} & {_esc(row['reason'])} & {_esc(row['policy'])} \\\\\n")
+    chunks.append("\\bottomrule\n\\end{tabular}\n\\end{table*}\n")
+    for block in SOURCE_BLOCKS:
+        rel = block.path.relative_to(REPO_ROOT)
+        digest = _sha(block.path)
+        chunks.append(f"\n\\subsection{{{_esc(block.title)}}}\n\\noindent Source: \\texttt{{{_esc(str(rel))}}}. Provenance: {_esc(block.provenance)}. SHA-256: \\texttt{{{digest[:24]}...}}.\n\n")
+        chunks.append(f"\\begin{{lstlisting}}[style=echoforgecode,language={block.language},caption={{{_esc(str(rel))} excerpt}}]\n")
+        chunks.append(_slice(block.path, block.start_line, block.end_line))
+        chunks.append("\\end{lstlisting}\n")
+    path.write_text("".join(chunks), encoding="utf-8")
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out-dir", type=Path, default=OUT_DIR)
+    args = parser.parse_args(); args.out_dir.mkdir(parents=True, exist_ok=True)
+    write_cli(args.out_dir / "appendix_cli_commands.tex")
+    write_sources(args.out_dir / "appendix_source_listings.tex")
+    return 0
+
+if __name__ == "__main__":
+    raise SystemExit(main())
