+digests, and a printed encrypted excerpt for the highest-IP EI core. The source
+repository remains the authoritative review surface; the PDF appendix is a
+reader-facing index plus printable evidence.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+import os
+from dataclasses import dataclass
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+
+@dataclass(frozen=True)
+class CodeFile:
+    role: str
+    path: Path
+    origin: str
+    reason: str
+
+
+def _discover(patterns: list[str]) -> list[Path]:
+    found: list[Path] = []
+    for pattern in patterns:
+        found.extend(REPO_ROOT.glob(pattern))
+    return sorted({path for path in found if path.is_file()})
+
+
+def discover_code_files() -> list[CodeFile]:
+    files: list[CodeFile] = []
+    conventional_patterns = [
+        "detection/**/*baseline*.py",
+        "detection/**/*classical*.py",
+        "detection/**/*detector*.py",
+        "detection/main_run_types.py",
+    ]
+    fusion_patterns = [
+        "detection/**/*fusion*.py",
+        "detection/**/*c2*.py",
+    ]
+    ei_patterns = [
+        "detection/**/*advanced*.py",
+        "detection/**/*evolution*.py",
+        "detection/**/*candidate*.py",
+        "detection/paper_evidence_major_upgrade_v1.py",
+    ]
+    for path in _discover(conventional_patterns)[:8]:
+        files.append(CodeFile("human_baseline", path, "human", "conventional radar / ML detector implementation"))
+    for path in _discover(fusion_patterns)[:6]:
+        files.append(CodeFile("accepted_fusion", path, "human", "accepted human-engineered fusion comparator"))
+    for path in _discover(ei_patterns)[:8]:
+        files.append(CodeFile("engineered_intelligence", path, "generative", "EI-discovered or EI-supporting algorithm lane"))
+    # Ensure the paper evidence and figure code are indexed even when glob names differ.
+    for extra, role, origin, reason in [
+        (REPO_ROOT / "detection" / "paper_evidence_major_upgrade_v1.py", "evidence", "human", "paper evidence generator"),
+        (REPO_ROOT / "paper" / "generate_figures_major_upgrade_v2.py", "figures", "human", "deterministic figure renderer"),
+    ]:
+        if extra.exists() and all(item.path != extra for item in files):
+            files.append(CodeFile(role, extra, origin, reason))
+    return files
+
+
+def latex_escape(text: str) -> str:
+    replacements = {
+        "\\": r"\textbackslash{}",
+        "&": r"\&",
+        "%": r"\%",
+        "$": r"\$",
+        "#": r"\#",
+        "_": r"\_",
+        "{": r"\{",
+        "}": r"\}",
+        "~": r"\textasciitilde{}",
+        "^": r"\textasciicircum{}",
+    }
+    return "".join(replacements.get(ch, ch) for ch in text)
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def origin_for_line(meta: CodeFile, line: str) -> str:
+    lowered = line.lower()
+    if meta.origin == "generative" or any(token in lowered for token in ("evolution", "candidate", "geodesic", "component_weight", "selection_lock")):
+        return "generative"
+    return "human"
+
+
+def choose_high_ip_lines(lines: list[str]) -> list[int]:
+    scored: list[tuple[int, int]] = []
+    for idx, line in enumerate(lines):
+        lowered = line.lower()
+        score = 0
+        for token in ("geodesic", "component", "candidate", "evolution", "selection", "calibration", "objective", "fpr", "recall"):
+            if token in lowered:
+                score += 2
+        if line.strip().startswith(("def ", "class ")):
+            score += 1
+        if score:
+            scored.append((score, idx))
+    if not scored:
+        return []
+    scored.sort(reverse=True)
+    n = max(1, int(0.12 * len(lines)))
+    return sorted(idx for _score, idx in scored[:n])
+
+
+def xor_encrypt(text: str, key: str) -> str:
+    if not key:
+        digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
+        return "SHA256-ONLY:" + digest
+    payload = text.encode("utf-8")
+    key_bytes = hashlib.sha256(key.encode("utf-8")).digest()
+    out = bytes(byte ^ key_bytes[idx % len(key_bytes)] for idx, byte in enumerate(payload))
+    return "XOR-SHA256KEY:" + base64.b64encode(out).decode("ascii")
+
+
+def render_code_file(meta: CodeFile, *, max_lines: int | None = None) -> tuple[str, dict[str, object]]:
+    rel = meta.path.relative_to(REPO_ROOT).as_posix()
+    raw_lines = meta.path.read_text(encoding="utf-8", errors="replace").splitlines()
+    lines = raw_lines if max_lines is None else raw_lines[:max_lines]
+    encrypted_indices = set(choose_high_ip_lines(raw_lines)) if meta.origin == "generative" else set()
+    key = os.environ.get("ECHOFORGE_APPENDIX_ENCRYPTION_KEY", "")
+    rendered: list[str] = []
+    rendered.append(r"\subsubsection{" + latex_escape(rel) + r"}")
+    rendered.append(latex_escape(meta.reason) + r"\\")
+    rendered.append(r"\textbf{SHA256:} \texttt{" + sha256(meta.path)[:32] + r"...}" )
+    rendered.append(r"\begin{Verbatim}[fontsize=\scriptsize,breaklines=true,breakanywhere=true]")
+    for idx, line in enumerate(lines):
+        prefix = "GEN" if origin_for_line(meta, line) == "generative" else "HUM"
+        if idx in encrypted_indices:
+            prefix = "ENC"
+            line = "<encrypted high-IP line; see encrypted excerpt block>"
+        rendered.append(f"{idx + 1:04d} {prefix} | {line}")
+    rendered.append(r"\end{Verbatim}")
+    encrypted_payload = ""
+    if encrypted_indices:
+        excerpt = "\n".join(raw_lines[idx] for idx in sorted(encrypted_indices))
+        encrypted_payload = xor_encrypt(excerpt, key)
+        rendered.append(r"\paragraph{Encrypted high-IP excerpt.}")
+        rendered.append(r"\begin{Verbatim}[fontsize=\tiny,breaklines=true,breakanywhere=true]")
+        rendered.append(encrypted_payload)
+        rendered.append(r"\end{Verbatim}")
+    manifest_row = {
+        "path": rel,
+        "role": meta.role,
+        "origin": meta.origin,
+        "sha256": sha256(meta.path),
+        "line_count": len(raw_lines),
+        "encrypted_line_count": len(encrypted_indices),
+        "encrypted_payload_prefix": encrypted_payload[:24],
+    }
+    return "\n".join(rendered), manifest_row
+
+
+def generate(out: Path, manifest: Path, max_lines: int | None) -> None:
+    files = discover_code_files()
+    rows: list[dict[str, object]] = []
+    chunks = [
+        r"\section{Source-Code Appendix}",
+        r"This appendix indexes the reviewable implementation. Prefixes mark line origin: HUM = conventional human-authored implementation, GEN = generative-origin or EI-discovered implementation, ENC = encrypted high-IP excerpt in the printed appendix. The repository source remains authoritative.",
+    ]
+    for meta in files:
+        chunk, row = render_code_file(meta, max_lines=max_lines)
+        chunks.append(chunk)
+        rows.append(row)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text("\n\n".join(chunks) + "\n", encoding="utf-8")
+    manifest.parent.mkdir(parents=True, exist_ok=True)
+    manifest.write_text(json.dumps({"files": rows}, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, default=REPO_ROOT / "paper" / "generated_code_appendix.tex")
+    parser.add_argument("--manifest", type=Path, default=REPO_ROOT / "outputs" / "paper-evidence" / "major-upgrade-v1" / "code_appendix_manifest.json")
+    parser.add_argument("--max-lines", type=int, default=None, help="debug limit; omit for full source appendix")
+    args = parser.parse_args()
+    generate(args.out, args.manifest, args.max_lines)
+    print(args.out)
+    print(args.manifest)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
