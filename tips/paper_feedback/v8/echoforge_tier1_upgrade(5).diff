diff --git a/paper/build_source_appendix.py b/paper/build_source_appendix.py
new file mode 100755
index 0000000..a02b4ce
--- /dev/null
+++ b/paper/build_source_appendix.py
@@ -0,0 +1,218 @@
+#!/usr/bin/env python3
+"""Generate the paper source-code appendix from a manifest."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+DEFAULT_MANIFEST = REPO_ROOT / "paper" / "source_appendix_manifest.json"
+DEFAULT_OUT = REPO_ROOT / "paper" / "source_appendix_generated.tex"
+
+PROVENANCE_STYLE = {
+    "human_standard": "EchoHumanCode",
+    "generated_ei_influenced": "EchoGenCode",
+    "high_ip_redacted": "EchoRedactedCode",
+}
+
+
+def _read_json(path: Path) -> dict[str, Any]:
+    payload = json.loads(path.read_text(encoding="utf-8"))
+    return payload if isinstance(payload, dict) else {}
+
+
+def _latex_escape(text: Any) -> str:
+    value = str(text)
+    replacements = {
+        "\\": r"\textbackslash{}",
+        "&": r"\&",
+        "%": r"\%",
+        "$": r"\$",
+        "#": r"\#",
+        "_": r"\_",
+        "{": r"\{",
+        "}": r"\}",
+        "~": r"\textasciitilde{}",
+        "^": r"\textasciicircum{}",
+    }
+    for old, new in replacements.items():
+        value = value.replace(old, new)
+    return value
+
+
+def _read_range(path: Path, start: int, end: int) -> tuple[str, str]:
+    lines = path.read_text(encoding="utf-8").splitlines()
+    selected = lines[start - 1 : end]
+    text = "\n".join(selected) + ("\n" if selected else "")
+    digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
+    return text, digest
+
+
+def _write_listing(path: Path, code: str, block_id: str, range_idx: int) -> Path:
+    out_dir = REPO_ROOT / "paper" / "generated_source_snippets"
+    out_dir.mkdir(parents=True, exist_ok=True)
+    snippet_path = out_dir / f"{block_id}_{range_idx}.py"
+    snippet_path.write_text(code, encoding="utf-8")
+    return snippet_path
+
+
+def _relative(path: Path) -> str:
+    try:
+        return path.relative_to(REPO_ROOT).as_posix()
+    except ValueError:
+        return path.as_posix()
+
+
+def _redaction_box(block: dict[str, Any], source_path: Path, start: int, end: int, digest: str) -> list[str]:
+    redaction = block.get("redaction", {}) if isinstance(block.get("redaction"), dict) else {}
+    ciphertext = redaction.get("ciphertext_path", "not published in repo")
+    reason = redaction.get("reason", "high-IP block withheld from paper form")
+    return [
+        r"\begin{claimbox}",
+        r"\textbf{High-IP redaction envelope.} "
+        + _latex_escape(block.get("title", block.get("id", "redacted block")))
+        + r"\\",
+        r"Source: \texttt{" + _latex_escape(_relative(source_path)) + r"}, lines " + f"{start}--{end}" + r"\\",
+        r"SHA-256 digest of withheld plaintext range: \texttt{" + digest + r"}\\",
+        r"Ciphertext reference: \texttt{" + _latex_escape(ciphertext) + r"}\\",
+        r"Reason: " + _latex_escape(reason),
+        r"\end{claimbox}",
+    ]
+
+
+def generate(manifest_path: Path, output_path: Path) -> None:
+    manifest = _read_json(manifest_path)
+    blocks = manifest.get("blocks", [])
+    if not isinstance(blocks, list) or not blocks:
+        raise ValueError("source appendix manifest must contain a non-empty blocks list")
+
+    tex: list[str] = [
+        "% Auto-generated by paper/build_source_appendix.py; do not edit by hand.",
+        r"\appendices",
+        r"\section{Source Code Appendix}",
+        r"The following appendix is generated from \texttt{paper/source\_appendix\_manifest.json}. Neutral listings are human-standard baselines and accepted fusion. Light-blue listings are EI-generated/evolved code paths. High-IP blocks are represented by digest and optional ciphertext references rather than plaintext.",
+        "",
+        r"\begin{table*}[t]",
+        r"\caption{Source-Code Appendix Manifest}",
+        r"\label{tab:sourceappendixmanifest}",
+        r"\centering\scriptsize",
+        r"\begin{tabular}{@{}p{0.18\textwidth}p{0.42\textwidth}p{0.13\textwidth}p{0.19\textwidth}@{}}",
+        r"\toprule",
+        r"Block & Source path & Lines & Provenance \\",
+        r"\midrule",
+    ]
+    table_rows: list[str] = []
+    listing_sections: list[str] = []
+    for block in blocks:
+        block_id = str(block.get("id", "block"))
+        source_path = REPO_ROOT / str(block.get("path", ""))
+        provenance = str(block.get("provenance", "human_standard"))
+        bg_color = PROVENANCE_STYLE.get(provenance, "EchoHumanCode")
+        ranges = block.get("ranges", [])
+        if not source_path.exists():
+            raise FileNotFoundError(f"source appendix path missing: {source_path}")
+        if not isinstance(ranges, list) or not ranges:
+            raise ValueError(f"block {block_id} must define ranges")
+        for range_idx, range_spec in enumerate(ranges, start=1):
+            start = int(range_spec["start"])
+            end = int(range_spec["end"])
+            code, digest = _read_range(source_path, start, end)
+            title = str(block.get("title", block_id))
+            caption = str(block.get("caption", title))
+            table_rows.append(
+                _latex_escape(block_id)
+                + " & \\texttt{"
+                + _latex_escape(_relative(source_path))
+                + "} & "
+                + f"{start}--{end}"
+                + " & "
+                + _latex_escape(provenance)
+                + r" \\" 
+            )
+            listing_sections.extend([r"\subsection{" + _latex_escape(title) + r"}"])
+            listing_sections.append(_latex_escape(caption) + r"\\")
+            listing_sections.append(r"Digest: \texttt{" + digest + r"}")
+            if provenance == "high_ip_redacted":
+                listing_sections.extend(_redaction_box(block, source_path, start, end, digest))
+                listing_sections.append("")
+                continue
+            snippet_path = _write_listing(source_path, code, block_id, range_idx)
+            listing_sections.extend(
+                [
+                    r"\lstset{backgroundcolor=\color{" + bg_color + r"}}",
+                    r"\lstinputlisting[style=echoforgepython,firstnumber="
+                    + str(start)
+                    + r",caption={"
+                    + _latex_escape(title)
+                    + r"},label={lst:"
+                    + _latex_escape(block_id)
+                    + r"}]{"
+                    + _latex_escape(_relative(snippet_path))
+                    + r"}",
+                    r"\lstset{backgroundcolor=\color{white}}",
+                    "",
+                ]
+            )
+    tex.extend(table_rows)
+    tex.extend(
+        [
+            r"\bottomrule",
+            r"\end{tabular}",
+            r"\end{table*}",
+            "",
+            r"\begin{claimbox}",
+            r"\textbf{Source appendix color key.} Human-standard code uses a neutral background. EI-generated/evolved code uses light blue. High-IP blocks are represented by digest and ciphertext/redaction metadata.",
+            r"\end{claimbox}",
+            "",
+        ]
+    )
+    tex.extend(listing_sections)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    output_path.write_text("\n".join(tex) + "\n", encoding="utf-8")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
+    parser.add_argument("--out", type=Path, default=DEFAULT_OUT)
+    parser.add_argument("--force", action="store_true")
+    args = parser.parse_args()
+    if args.out.exists() and not args.force:
+        raise SystemExit(f"{args.out} already exists; pass --force to replace it")
+    generate(args.manifest, args.out)
+    print(f"wrote {args.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
