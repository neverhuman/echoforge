new file mode 100755
index 0000000..62b3120
--- /dev/null
+++ b/paper/summarize_ei_evolution.py
@@ -0,0 +1,182 @@
+#!/usr/bin/env python3
+"""Summarize the EI evolution trace for paper-facing evidence.
+
+This script is intentionally standalone. It does not re-score the holdout and
+does not select a model. It reads the already-written advanced lane artifacts
+and emits compact CSV/JSON summaries for the EI evolution plot and appendix.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import math
+from pathlib import Path
+from typing import Any
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+DEFAULT_ADVANCED_ROOT = (
+    REPO_ROOT
+    / "outputs"
+    / "detection"
+    / "runit-fixed-wing-pusher-proxy-v2-main-run-advanced-evolution"
+)
+DEFAULT_OUT_ROOT = REPO_ROOT / "outputs" / "paper-evidence" / "major-upgrade-v1"
+
+
+def _read_json(path: Path) -> dict[str, Any]:
+    if not path.exists():
+        return {}
+    payload = json.loads(path.read_text(encoding="utf-8"))
+    return payload if isinstance(payload, dict) else {}
+
+
+def _read_jsonl(path: Path) -> list[dict[str, Any]]:
+    if not path.exists():
+        return []
+    rows: list[dict[str, Any]] = []
+    with path.open(encoding="utf-8") as handle:
+        for line in handle:
+            line = line.strip()
+            if not line:
+                continue
+            payload = json.loads(line)
+            if isinstance(payload, dict):
+                rows.append(payload)
+    return rows
+
+
+def _safe_float(value: Any, default: float = float("nan")) -> float:
+    try:
+        parsed = float(value)
+    except (TypeError, ValueError):
+        return default
+    return parsed if math.isfinite(parsed) else default
+
+
+def _write_csv(path: Path, rows: list[dict[str, Any]], fieldnames: list[str]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("w", encoding="utf-8", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fieldnames)
+        writer.writeheader()
+        writer.writerows(rows)
+
+
+def _write_json(path: Path, payload: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def summarize(advanced_root: Path) -> tuple[list[dict[str, Any]], dict[str, Any]]:
+    trace = _read_jsonl(advanced_root / "evolution_trace.jsonl")
+    lock = _read_json(advanced_root / "selection_lock.json")
+    quality = _read_json(advanced_root / "fusion_quality_report.json")
+    performance = _read_json(advanced_root / "performance_summary.json")
+    rows: list[dict[str, Any]] = []
+    best_objective = -float("inf")
+    best_ap = -float("inf")
+    best_candidate = ""
+    family_counts: dict[str, int] = {}
+    calibrator_counts: dict[str, int] = {}
+    for idx, row in enumerate(trace, start=1):
+        candidate_id = str(row.get("candidate_id", ""))
+        objective = _safe_float(row.get("objective"))
+        train_ap = _safe_float(row.get("train_cv_average_precision"))
+        if math.isfinite(objective) and objective > best_objective:
+            best_objective = objective
+            best_candidate = candidate_id
+        if math.isfinite(train_ap) and train_ap > best_ap:
+            best_ap = train_ap
+        family = str(row.get("family", row.get("candidate_type", "unknown")))
+        calibrator = str(row.get("calibrator", "unknown"))
+        family_counts[family] = family_counts.get(family, 0) + 1
+        calibrator_counts[calibrator] = calibrator_counts.get(calibrator, 0) + 1
+        rows.append(
+            {
+                "candidate_index": idx,
+                "candidate_id": candidate_id,
+                "family": family,
+                "head": row.get("head", ""),
+                "calibrator": calibrator,
+                "objective": f"{objective:.9f}" if math.isfinite(objective) else "",
+                "train_cv_average_precision": f"{train_ap:.9f}" if math.isfinite(train_ap) else "",
+                "train_cv_roc_auc": row.get("train_cv_roc_auc", ""),
+                "train_cv_f1": row.get("train_cv_f1", ""),
+                "holdout_rows_used_for_selection": row.get("holdout_rows_used_for_selection", 0),
+                "best_so_far_objective": f"{best_objective:.9f}" if math.isfinite(best_objective) else "",
+                "best_so_far_train_cv_ap": f"{best_ap:.9f}" if math.isfinite(best_ap) else "",
+                "best_so_far_candidate_id": best_candidate,
+            }
+        )
+    selected = performance.get("advanced_selection", {}) if isinstance(performance, dict) else {}
+    promotion = quality.get("promotion_gate", {}) if isinstance(quality, dict) else {}
+    summary = {
+        "status": "pass" if rows and lock else "missing_input",
+        "advanced_root": str(advanced_root),
+        "candidate_trace_count": len(rows),
+        "family_counts": family_counts,
+        "calibrator_counts": calibrator_counts,
+        "best_train_cv_candidate_id": best_candidate,
+        "best_train_cv_objective": best_objective if math.isfinite(best_objective) else None,
+        "best_train_cv_average_precision": best_ap if math.isfinite(best_ap) else None,
+        "selected_candidate_id": lock.get("selected_candidate_id"),
+        "selection_split": lock.get("selection_split", "train_cv"),
+        "holdout_rows_used_for_selection": lock.get("split_isolation_policy", {}).get(
+            "holdout_rows_used_for_candidate_selection", 0
+        ),
+        "selected_holdout_average_precision": promotion.get("selected_holdout_average_precision"),
+        "selected_holdout_roc_auc": promotion.get("selected_holdout_roc_auc"),
+        "selected_method": selected.get("selected_method"),
+        "strict_note": "Trace rows are train/CV-only; holdout appears only through the already-written post-lock quality summary.",
+    }
+    return rows, summary
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--advanced-root", type=Path, default=DEFAULT_ADVANCED_ROOT)
+    parser.add_argument("--out-root", type=Path, default=DEFAULT_OUT_ROOT)
+    parser.add_argument("--force", action="store_true")
+    args = parser.parse_args()
+    out_csv = args.out_root / "ei_evolution_summary.csv"
+    out_json = args.out_root / "ei_evolution_summary.json"
+    if (out_csv.exists() or out_json.exists()) and not args.force:
+        raise SystemExit("EI evolution summary exists; pass --force to replace it")
+    rows, summary = summarize(args.advanced_root)
+    _write_csv(
+        out_csv,
+        rows,
+        [
+            "candidate_index",
+            "candidate_id",
+            "family",
+            "head",
+            "calibrator",
+            "objective",
+            "train_cv_average_precision",
+            "train_cv_roc_auc",
+            "train_cv_f1",
+            "holdout_rows_used_for_selection",
+            "best_so_far_objective",
+            "best_so_far_train_cv_ap",
+            "best_so_far_candidate_id",
+        ],
+    )
+    _write_json(out_json, summary)
+    print(f"wrote {out_csv} rows={len(rows)} status={summary['status']}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
